HOST=127.0.0.1
PORT=8787
GITHUB_WEBHOOK_PATH=/webhooks/github
GITHUB_WEBHOOK_SECRET=replace-with-the-secret-you-set-in-github
WEBHOOK_EVENT_DIR=.webhook-events
MAX_BODY_BYTES=25000000
ALLOWED_EVENTS=issues,issue_comment,pull_request,pull_request_review_comment

# $agent uses AGENT_DEFAULT. $codex and $claude select the respective CLI.
AGENT_TRIGGER_TAG=agent
AGENT_DEFAULT=codex
AGENT_TAGS=codex,claude

CODEX_COMMAND=codex
CODEX_DEFAULT_MODEL=gpt-5.5
CODEX_EXTRA_ARGS_JSON=[]
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_WORKING_DIRECTORY=
CODEX_EXEC_TIMEOUT_MS=3600000
CODEX_ENV_PASSTHROUGH_JSON=["CODEX_HOME"]

CLAUDE_COMMAND=claude
# Leave empty to use Claude's configured default model.
CLAUDE_MODEL=
CLAUDE_EXTRA_ARGS_JSON=["--permission-mode","acceptEdits"]
CLAUDE_WORKING_DIRECTORY=
CLAUDE_EXEC_TIMEOUT_MS=3600000
CLAUDE_ENV_PASSTHROUGH_JSON=["CLAUDE_CONFIG_DIR"]

GITHUB_RESPONSE_ENABLED=true
GITHUB_CONTEXT_ENABLED=true
GITHUB_CONTEXT_INLINE_MAX_BYTES=120000
GITHUB_COMMAND=gh
GITHUB_COMPLETION_REACTION=+1
GITHUB_ENV_PASSTHROUGH_JSON=["GH_TOKEN","GITHUB_TOKEN","GH_HOST"]
DRY_RUN=false
AGENT_PROMPT_PREFIX=
