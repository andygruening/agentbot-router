HOST=127.0.0.1
PORT=8787
GITHUB_WEBHOOK_PATH=/webhooks/github
GITHUB_WEBHOOK_SECRET=replace-with-the-secret-you-set-in-github
WEBHOOK_EVENT_DIR=.webhook-events
MAX_BODY_BYTES=25000000
ALLOWED_EVENTS=issues,issue_comment,pull_request,pull_request_review_comment

# Jev completes every tag that omits an agent, model, or reasoning level.
AGENT_TRIGGER_TAG=agent
AGENT_TAGS=codex

# Required for routing incomplete agent tags.
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key
JEV_CHOICES_PATH=jev-choices.json

DOCKER_COMMAND=docker
AGENT_DOCKER_IMAGE=agentbot-router-agent:latest
REPOSITORY_DOCKER_IMAGE=agentbot-router-repository:latest
AGENT_DOCKER_PULL=false
AGENT_EXEC_TIMEOUT_MS=3600000
CODEX_AUTH_VOLUME=agentbot-router-codex-auth
CLAUDE_AUTH_VOLUME=agentbot-router-claude-auth
GITHUB_RESPONSE_ENABLED=true
GITHUB_CONTEXT_ENABLED=true
# Required for repository operations and GitHub responses.
GH_TOKEN=
GITHUB_CONTEXT_INLINE_MAX_BYTES=120000
GITHUB_COMMAND=gh
GITHUB_COMPLETION_REACTION=+1
GITHUB_ENV_PASSTHROUGH_JSON=["GH_TOKEN","GITHUB_TOKEN","GH_HOST"]
DRY_RUN=false
AGENT_PROMPT_PREFIX=
